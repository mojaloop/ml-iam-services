{
  "name": "@mojaloop/ml-iam-services",
  "version": "0.2.0-snapshot.2",
  "description": "Mojaloop Ory IAM Services - Keto batch auth proxy and Kratos role webhook",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mojaloop/ml-iam-services.git"
  },
  "keywords": [
    "mojaloop",
    "ory",
    "keto",
    "kratos",
    "iam",
    "authorization"
  ],
  "author": "Yevhen Kyriukha <kirgene@gmail.com>",
  "contributors": [
    "Yevhen Kyriukha <kirgene@gmail.com>"
  ],
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/mojaloop/ml-iam-services/issues"
  },
  "homepage": "https://github.com/mojaloop/ml-iam-services#readme",
  "bin": {
    "ml-iam-services": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "prepare": "husky || true",
    "postinstall": "patch-package",
    "prepublishOnly": "npm run build",
    "lint": "eslint src test",
    "lint:fix": "npm run lint -- --fix",
    "build": "tsc && cp src/api/*.yaml dist/api/",
    "watch": "tsc -w",
    "start": "node dist/cli.js",
    "start:dev": "ts-node src/cli.ts",
    "test": "npm run test:unit",
    "test:unit": "vitest run --project unit",
    "test:xunit": "vitest run --project unit --reporter=junit --outputFile=./test/reports/xunit.xml",
    "test:coverage": "vitest run --project unit --coverage",
    "test:coverage-check": "vitest run --project unit --coverage",
    "test:integration": "./test/scripts/test-integration.sh",
    "test:functional": "echo 'No functional tests yet'",
    "audit:check": "npx audit-ci --config ./audit-ci.jsonc",
    "dep:check": "npx --no-install ncu -e 2",
    "dep:update": "npx --no-install ncu -u",
    "release": "npx commit-and-tag-version --no-verify --releaseCommitMessageFormat 'ci(release): {{currentTag}} [skip ci]'",
    "snapshot": "npx commit-and-tag-version --no-verify --skip.changelog --prerelease snapshot --releaseCommitMessageFormat 'ci(snapshot): {{currentTag}}'"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/formbody": "^9.0.1",
    "@fastify/reply-from": "^12.8.0",
    "@fastify/sse": "^0.6.1",
    "@mojaloop/authz": "^0.17.2",
    "@ory/client": "^1.22.66",
    "@scalar/openapi-parser": "^0.28.14",
    "commander": "^14.0.3",
    "dotenv": "^17.4.2",
    "env-var": "^7.5.0",
    "escape-html": "^1.0.3",
    "fastify": "^5.12.7",
    "fastify-openapi-glue": "^4.12.0",
    "http-status-codes": "^2.3.0",
    "json-ptr": "^3.1.1",
    "kubernetes-fluent-client": "^3.11.11",
    "openapi-backend": "^5.20.1",
    "parse-link-header": "^2.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.2",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "@types/escape-html": "^1.0.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/parse-link-header": "^2.0.3",
    "@types/supertest": "^7.2.0",
    "audit-ci": "^7.1.0",
    "commit-and-tag-version": "^12.7.1",
    "eslint": "10.2.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eventsource-parser": "^4.1.3",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "jest-junit": "^17.0.0",
    "lint-staged": "^16.4.0",
    "npm-check-updates": "22.0.1",
    "patch-package": "^8.0.1",
    "prettier": "3.8.3",
    "supertest": "^7.2.2",
    "ts-jest": "29.4.9",
    "ts-node": "10.9.2",
    "tsx": "^4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "./src/*.ts": [
      "eslint --fix",
      "prettier --write --ignore-unknown"
    ]
  },
  "imports": {
    "#src/*": "./dist/*.js",
    "#test/*": "./test/*.ts"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.2.1",
      "onFail": "error"
    }
  },
  "allowScripts": {
    "esbuild": false,
    "unrs-resolver": false
  }
}
