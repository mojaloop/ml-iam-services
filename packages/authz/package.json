{
  "name": "@mojaloop/authz",
  "version": "0.19.0",
  "description": "The authorization contract services speak with the platform",
  "license": "Apache-2.0",
  "author": "Yevhen Kyriukha <kirgene@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mojaloop/ml-iam-services.git",
    "directory": "packages/authz"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./gateway": {
      "import": { "types": "./dist/gateway.d.ts", "default": "./dist/gateway.js" },
      "require": { "types": "./dist/gateway.d.cts", "default": "./dist/gateway.cjs" }
    },
    "./document": {
      "import": { "types": "./dist/document.d.ts", "default": "./dist/document.js" },
      "require": { "types": "./dist/document.d.cts", "default": "./dist/document.cjs" }
    },
    "./reserved": {
      "import": { "types": "./dist/reserved.d.ts", "default": "./dist/reserved.js" },
      "require": { "types": "./dist/reserved.d.cts", "default": "./dist/reserved.cjs" }
    },
    "./testing": {
      "import": { "types": "./dist/testing.d.ts", "default": "./dist/testing.js" },
      "require": { "types": "./dist/testing.d.cts", "default": "./dist/testing.cjs" }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "path-to-regexp": "^8.4.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.2.1",
      "onFail": "error"
    }
  }
}
