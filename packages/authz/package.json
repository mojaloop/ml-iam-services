{
  "name": "@mojaloop/authz",
  "version": "0.13.2",
  "description": "The authorization contract services speak with the platform",
  "license": "Apache-2.0",
  "author": "Mojaloop Foundation",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mojaloop/ml-iam-services.git",
    "directory": "packages/authz"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./gateway": {
      "import": { "types": "./dist/gateway.d.ts", "default": "./dist/gateway.js" },
      "require": { "types": "./dist/gateway.d.cts", "default": "./dist/gateway.cjs" }
    },
    "./document": {
      "import": { "types": "./dist/document.d.ts", "default": "./dist/document.js" },
      "require": { "types": "./dist/document.d.cts", "default": "./dist/document.cjs" }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "path-to-regexp": "^8.4.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  }
}
