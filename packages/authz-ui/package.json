{
  "name": "@mojaloop/authz-ui",
  "version": "0.3.2",
  "description": "A typed client, React hooks and components for the IAM's public API, and custom elements any page can host",
  "license": "Apache-2.0",
  "author": "Yevhen Kyriukha <kirgene@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mojaloop/ml-iam-services.git",
    "directory": "packages/authz-ui"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "require": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      }
    },
    "./elements": {
      "types": "./dist/elements.d.ts",
      "default": "./dist/elements.js"
    },
    "./elements/define": {
      "types": "./dist/elements-define.d.ts",
      "default": "./dist/elements-define.js"
    },
    "./elements/names": {
      "types": "./dist/elements-names.d.ts",
      "default": "./dist/elements-names.js"
    },
    "./default.css": "./dist/default.css"
  },
  "sideEffects": [
    "*.css",
    "./dist/elements-define.js"
  ],
  "files": [
    "dist",
    "client",
    "elements"
  ],
  "dependencies": {
    "@mojaloop/authz": "^0.17.2",
    "openapi-fetch": "^0.17.0"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.105.0",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.105.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@tsdown/css": "^0.23.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.4",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "generate": "openapi-typescript ../../src/api/public.yaml --output src/generated/public.ts",
    "prebuild": "npm run generate",
    "build": "tsdown",
    "pretypecheck": "npm run generate",
    "typecheck": "tsc",
    "pretest": "npm run generate",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  }
}
